<?xml version="1.0" encoding="utf-8"?>
<!--
    Shelfly logomark: a sprouting leaf glyph.
    Stem + left leaf + right sprout leaf — same geometry as the design artboard ShelflyMark.
    Primary color (#3F6B26) on primaryContainer (#C0F0A1) background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stem -->
    <path
        android:pathData="M54,88 L54,52"
        android:strokeColor="#3F6B26"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Left leaf -->
    <path
        android:pathData="M54,58 C 40,58, 30,46, 30,36 C 44,36, 54,48, 54,58 Z"
        android:fillColor="#3F6B26" />

    <!-- Right sprout leaf (taller) -->
    <path
        android:pathData="M54,52 C 54,30, 64,16, 78,16 C 78,40, 68,52, 54,52 Z"
        android:fillColor="#3F6B26" />
</vector>
