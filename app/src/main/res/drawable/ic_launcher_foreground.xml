<?xml version="1.0" encoding="utf-8"?>
<!--
    Shelfly logomark: a sprouting leaf glyph.
    Stem + left leaf + right sprout leaf — same geometry as the design artboard ShelflyMark.
    Primary color (#3F6B26) on primaryContainer (#C0F0A1) background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stem (shortened: top raised from y=52 to y=62) -->
    <path
        android:pathData="M54,88 L54,62"
        android:strokeColor="#3F6B26"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Left leaf (all y +10 to match new stem top) -->
    <path
        android:pathData="M54,68 C 40,68, 30,56, 30,46 C 44,46, 54,58, 54,68 Z"
        android:fillColor="#3F6B26" />

    <!-- Right leaf (all y +10; tip at y=32 safely inside safe zone) -->
    <path
        android:pathData="M54,62 C 54,42, 65,32, 76,32 C 76,50, 67,62, 54,62 Z"
        android:fillColor="#3F6B26" />
</vector>
