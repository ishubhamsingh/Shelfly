<?xml version="1.0" encoding="utf-8"?>
<!--
    Custom big content view for expiry notifications.
    Used with DecoratedCustomViewStyle — the system renders the standard
    notification header (app icon, name, time) above this view.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/notif_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/notif_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Chips row — items added programmatically via RemoteViews.addView() -->
    <LinearLayout
        android:id="@+id/notif_chips_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />

</LinearLayout>
